{
  "name": "fae-vscode-plugin",
  "displayName": "FAE",
  "description": "Chat with Free Agent Engine agents from VS Code.",
  "version": "0.1.0",
  "publisher": "free-agent-engine",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:fae.chatView",
    "onCommand:fae.openChat",
    "onCommand:fae.newConversation",
    "onCommand:fae.openSettings",
    "onCommand:fae.openInTerminal"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fae.openChat",
        "title": "FAE: Open Chat",
        "category": "FAE"
      },
      {
        "command": "fae.newConversation",
        "title": "FAE: New Conversation",
        "category": "FAE",
        "icon": "$(add)"
      },
      {
        "command": "fae.openSettings",
        "title": "FAE: Open Settings",
        "category": "FAE",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fae.openInTerminal",
        "title": "FAE: Open Agent in Terminal",
        "category": "FAE",
        "icon": "$(terminal)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fae",
          "title": "FAE",
          "icon": "resources/fae.svg"
        }
      ]
    },
    "views": {
      "fae": [
        {
          "id": "fae.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "fae.newConversation",
          "when": "view == fae.chatView",
          "group": "navigation@1"
        },
        {
          "command": "fae.openSettings",
          "when": "view == fae.chatView",
          "group": "navigation@2"
        },
        {
          "command": "fae.openInTerminal",
          "when": "view == fae.chatView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "FAE",
      "properties": {
        "fae.command": {
          "type": "string",
          "default": "fae",
          "description": "Path to the FAE CLI executable."
        },
        "fae.workspace": {
          "type": "string",
          "default": "main",
          "description": "FAE workspace name passed to --ws."
        },
        "fae.agentId": {
          "type": "string",
          "default": "fae-assistant",
          "description": "Agent id passed to --id."
        },
        "fae.userId": {
          "type": "string",
          "default": "master",
          "description": "User id passed to --user."
        },
        "fae.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory used when launching FAE. Defaults to the current VS Code workspace folder."
        },
        "fae.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments appended to the FAE CLI command."
        },
        "fae.usePseudoTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Legacy option for wrapping the FAE CLI with the macOS/Linux script command. The webview chat uses --stdio by default and normally does not need this."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
