{
  "id": "plan_runtime_demo",
  "plugin_version": "1.0.0",
  "fae_plugin_api_version": "0.3.0",
  "registration_mode": "chain",
  "engine": "py",
  "description": "Plan chain and a registered JSON Runtime",
  "mounts": [
    {"point": "Plan", "id": "audit_plan", "implementation": "plugin.py:Audit", "next_plan_id": "report_plan"},
    {"point": "Plan", "id": "report_plan", "implementation": "plugin.py:Report"},
    {"point": "Runtime", "id": "report_runtime", "implementation": "plugin.py:ReportRuntime",
     "task_types": ["report_fetch"], "public_calls": {"exec": "report_fetch", "select": "report_fetch"}}
  ]
}
